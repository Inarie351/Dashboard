# Copy this file to `.env` at the project root to override the docker-compose defaults.
# Nothing here is required — `docker-compose up` works out of the box with the defaults
# baked into docker-compose.yml.

POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard

NODE_ENV=production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

OPENWEATHER_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# OAuth (per-user login) for the `youtube` and `discord` services.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_CALLBACK_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_CALLBACK_URL=
# Bot of the same Discord application (Bot tab), used by the `channel_messages` widget to read the
# public channels of servers it was invited to. Enable the Message Content intent for the text.
DISCORD_BOT_TOKEN=

# Contact shown on the legal notice / privacy page (/legal) for GDPR requests — whoever deploys
# this instance is its data controller. Leave empty to show a generic "administrator" mention.
LEGAL_CONTACT_EMAIL=

# Comma-separated emails promoted to ADMIN on registration.
ADMIN_EMAILS=

# Confirmation emails go to MailHog by default — a fake SMTP server with a web inbox at
# http://localhost:8025, no setup required. Set these to a real SMTP provider (Gmail app
# password, SendGrid, Mailgun, ...) to actually deliver emails instead.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
